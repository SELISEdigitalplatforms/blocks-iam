# Exposed via `envPrefix: ['BLOCKS_']` in vite.config (access via `import.meta.env.BLOCKS_*`).
# Copy to `.env` and set values. Restart `npm run dev` after changes.
BLOCKS_X_BLOCKS_KEY=
BLOCKS_GOOGLE_SITE_KEY=
BLOCKS_CONSTRUCT_URL=
BLOCKS_GITHUB_SSO_CLIENT_ID=
BLOCKS_OIDC_CLIENT_ID=
BLOCKS_BASE_DOMAIN=
BLOCKS_IAM_BASE_URL=
BLOCKS_IAM_CALLBACK_URL=
BLOCKS_LOCALIZATION_BASE_URL=
BLOCKS_LOCALIZATION_CALLBACK_URL=
BLOCKS_AGENTS_BASE_URL=
BLOCKS_AGENTS_CALLBACK_URL=
BLOCKS_DATA_BASE_URL=
BLOCKS_DATA_CALLBACK_URL=
BLOCKS_OS_BASE_URL=
BLOCKS_OS_CALLBACK_URL=
BLOCKS_UTILITIES_BASE_URL=
BLOCKS_UTILITIES_CALLBACK_URL=
BLOCKS_LOGIC_BASE_URL=
BLOCKS_LOGIC_CALLBACK_URL=
BLOCKS_MONITOR_BASE_URL=
BLOCKS_MONITOR_CALLBACK_URL=
BLOCKS_RELEASE_BASE_URL=
BLOCKS_RELEASE_CALLBACK_URL=
BLOCKS_STUDIO_BASE_URL=
BLOCKS_STUDIO_CALLBACK_URL=
BLOCKS_DEV_HOST=

# ---------------------------------------------------------------------------
# Local HTTPS (frontend dev server + .NET backend)
# ---------------------------------------------------------------------------
# These are NOT set here. They are MACHINE / USER environment variables, read
# directly from the OS (not BLOCKS_-prefixed, not loaded from this .env):
#
#   IAM_SSL_CERT = absolute path to an mkcert cert PEM
#   IAM_SSL_KEY  = absolute path to the matching key PEM
#
# Rule (frontend + backend): both set AND both files exist -> HTTPS on
# https://dev-iam.blocksdevelopers.com (FE :4000, API :5000);
# otherwise HTTP. Never hard-fails. See LOCAL_GUIDE.md for one-time setup.
