# Copy this file to `.env.e2e` (gitignored) and fill in real values.

# Base URL of the Blocks IAM app under test.
#
# Remote host (no local build needed) — also set E2E_NO_WEBSERVER=1 below:
#   E2E_BASE_URL=https://dev-iam.blocksdevelopers.com
#
# Local build on :5001 — requires a hosts entry pointing the domain at
# 127.0.0.1, e.g.
#   127.0.0.1 dev-iam.blocksdevelopers.com
# Without it the tests hit the remote host instead of your machine.
E2E_BASE_URL=https://dev-iam.blocksdevelopers.com:5001

# Dev-IAM test account credentials (captcha is disabled on dev).
E2E_USERNAME=example@yopmail.com
E2E_PASSWORD=strong password

# Set to 1 to skip auto-starting the app (you manage the server yourself).
# Required when E2E_BASE_URL points at a remote host — otherwise
# Playwright runs `run.sh -b` to boot a local API you don't want.
# E2E_NO_WEBSERVER=1

# Pause after each test so the end state is watchable. Defaults to 10000 in
# headed mode and 0 when headless; set a value to override either way.
# E2E_PAUSE_MS=10000

# Milliseconds of delay per action, to watch the steps themselves.
# E2E_SLOWMO=600
