# Copy this file to `.env.e2e` (gitignored) and fill in real values.
#
# Switch environments by changing E2E_BASE_URL only — OS is derived automatically:
#   Dev:  https://dev-iam.blocksdevelopers.com  → OS https://dev-os.blocksdevelopers.com
#   Prod: https://iam.seliseblocks.com          → OS https://os.seliseblocks.com
# Override OS anytime with E2E_OS_BASE_URL.

# ── Dev (blocksdevelopers.com) ──────────────────────────────────────────────
E2E_BASE_URL=https://dev-iam.blocksdevelopers.com
# E2E_OS_BASE_URL=https://dev-os.blocksdevelopers.com

# ── Prod (seliseblocks.com) — uncomment these and comment Dev above ──────────
# E2E_BASE_URL=https://iam.seliseblocks.com
# E2E_OS_BASE_URL=https://os.seliseblocks.com

# Local build via named domain + hosts entry (API_PORT 5001, see run.sh):
#   127.0.0.1 dev-iam.blocksdevelopers.com
#   E2E_BASE_URL=https://dev-iam.blocksdevelopers.com:5001

# Test account credentials
E2E_USERNAME=
E2E_PASSWORD=

# Set to 1 to skip auto-starting the app (you manage the server, or remote host).
E2E_NO_WEBSERVER=1

# Pause after each test (default 10000 headed / 0 headless).
# E2E_PAUSE_MS=10000

# Milliseconds of delay per action.
# E2E_SLOWMO=600

# Extra hold at the end of the login spec specifically.
# E2E_HOLD_MS=120000
