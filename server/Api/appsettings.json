{
  "ServiceName": "blocks-iam",

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "SwaggerOptions": {
    "Version": "v1",
    "Title": "Blocks IDP API",
    "Description": "Blocks IDP API documentation",
    "XmlCommentsFilePath": "Api.xml",
    "EndpointUrl": "/swagger/v1/swagger.json",
    "EnableBearerAuth": true,
    "ServiceName": "blocks-idp"
  },

  "ApiRouting": {
    "Prefix": "api"
  },

  "FrontendRuntime": {
    "BLOCKS_API_BASE_URL": "http://localhost:5000",
    "BLOCKS_X_BLOCKS_KEY": "***REMOVED***",
    "BLOCKS_GOOGLE_SITE_KEY": "***REMOVED***",
    "BLOCKS_CONSTRUCT_URL": "https://dev-construct.seliseblocks.com",
    "BLOCKS_OIDC_CLIENT_ID": ""
  }
}
