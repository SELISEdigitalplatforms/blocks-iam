<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>10.0.0-preview.2</Version>
		<PackageId>SeliseBlocks.CaptchaDriver</PackageId>
		<Authors>SeliseBlocks</Authors>
		<Company>SeliseBlocks</Company>
		<Description>Blocks Captcha Driver</Description>
		<IncludeBuildOutput>true</IncludeBuildOutput>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageTags>Genesis, BlocksGenesis, SeliseBlocksGenesis, Captcha , Driver</PackageTags>
		<RepositoryUrl>https://github.com/SELISEdigitalplatforms/blocks-idp-net</RepositoryUrl>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>


	<ItemGroup>
	  <None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="../Captcha.DomainService/Captcha.DomainService.csproj" PrivateAssets="All" />
	</ItemGroup>


	<ItemGroup>
	  <None Remove="bin\Release\net10.0\Captcha.DomainService.dll" />
	</ItemGroup>
	<ItemGroup>
   		<None Include="$(OutputPath)Captcha.DomainService.dll" Pack="true" PackagePath="lib/net10.0/" />
	</ItemGroup>

	<!--
	  The bundled Captcha.DomainService.dll (added above via PrivateAssets="All" + manual
	  pack) carries these transitive dependencies. They must be declared here so they flow
	  to consumers as package dependencies; otherwise the bundled DLL fails to load at runtime.
	-->
	<ItemGroup>
      <PackageReference Include="FluentValidation" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
      <PackageReference Include="Newtonsoft.Json" />
      <PackageReference Include="SeliseBlocks.Genesis" />
      <PackageReference Include="SixLabors.Fonts" />
      <PackageReference Include="SixLabors.ImageSharp" />
      <PackageReference Include="SixLabors.ImageSharp.Drawing" />
      <PackageReference Include="System.Drawing.Common" />
	</ItemGroup>
</Project>
